{
  "name": "user-api-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript API automation suite with Allure reporting",
  "scripts": {
    "test:dev": "cross-env TEST_ENV=dev playwright test",
    "test:prod": "cross-env TEST_ENV=prod playwright test",
    "test:dev:stable": "cross-env TEST_ENV=dev playwright test --grep-invert @bug",
    "test:prod:stable": "cross-env TEST_ENV=prod playwright test --grep-invert @bug",
    "test:bugs": "cross-env TEST_ENV=dev playwright test --grep @bug",
    "typecheck": "tsc --noEmit",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "clean": "rimraf allure-results allure-report test-results playwright-report"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "allure-commandline": "^2.46.1",
    "allure-js-commons": "^3.13.0",
    "allure-playwright": "^3.13.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.7",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
